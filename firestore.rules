rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /environments/{dataId} {

      // User profiles: unchanged
      match /users/{uid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        match /contacts/{contactId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      function isParticipant() {
        return request.auth != null && 
        (request.auth.token.email in resource.data.participantEmails || request.auth.uid in resource.data.participantUids);
      }

      function isCreator() {
        return request.auth != null && request.auth.uid == resource.data.creatorUid;
      }

      // Helper: Check if the user's email is already in the invited list
      function isInvitedByEmail() {
        return request.auth != null && 
        request.auth.token.email in resource.data.participantEmails;
      }

      // Helper: Ensure ONLY specific fields are being modified
      function onlyUpdatingJoinFields() {
        let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
        // Participants can only touch 'participantUids' and 'participants'
        return affectedKeys.hasOnly(['participantUids', 'participants']);
      }

      // Helper: Verify the user is adding THEIR OWN UID and not someone else's
      function isAddingOwnUid() {
        return request.auth.uid in request.resource.data.participantUids;
      }

      // Shared expenses (Groups)
      match /sharedExpenses/{seId} {
        // Read if user's UID is in the participant list
        allow read: if isParticipant();

        // Create if the user sets themselves as creator
        allow create: if request.auth != null && request.auth.uid == request.resource.data.creatorUid;

        // Only creator can edit group settings or participants updating 
        allow update: if ( isCreator() || ( isInvitedByEmail() && onlyUpdatingJoinFields() && isAddingOwnUid() ));

        // Only creator can delete the group
        allow delete: if isCreator();

        // Sub-collections: Expenses and Payments
        match /{collection}/{docId} {

          // Must be a participant to even see the records
          allow read: if request.auth != null;

          // Permission to Create:
          // 1. User must be a participant.
          // 2. User is either the Group Creator OR the Email matches their auth email.
          allow create: if request.auth != null;

          // Permission to Update/Delete:
          // 1. Group Creator has total control.
          // 2. Participants can only edit/delete if their email matches the record.
          allow update, delete: if request.auth != null;
        }
      }
    }
  }
}
