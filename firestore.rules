rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /environments/{dataId} {

      // User profiles: unchanged
      match /users/{uid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        match /contacts/{contactId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      function isAuthenticated() {
        return request.auth != null;
      }

      function isParticipant() {
        return isAuthenticated() &&
          (request.auth.token.email in resource.data.participantEmails ||
           request.auth.uid in resource.data.participantUids);
      }

      function isCreator() {
        return isAuthenticated() && request.auth.uid == resource.data.creatorUid;
      }

      // Helper: Check if the user's email is already in the invited list
      function isInvitedByEmail() {
        return isAuthenticated() &&
          request.auth.token.email in resource.data.participantEmails;
      }

      // Helper: Ensure ONLY specific fields are being modified
      function onlyUpdatingJoinFields() {
        let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
        // Participants can only touch 'participantUids' and 'participants'
        return affectedKeys.hasOnly(['participantUids', 'participants', 'totalAmount']);
      }

      // Helper: Verify the user is adding THEIR OWN UID and not someone else's
      function isAddingOwnUid() {
        return request.auth.uid in request.resource.data.participantUids;
      }

      // Shared expenses (Groups)
      match /sharedExpenses/{seId} {
        // Read if user's UID or email is in the participant list
        allow read: if isParticipant();

        // Create if the user sets themselves as creator
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.creatorUid;

        // Only creator can edit group settings; invited users can only join (add their own UID)
        allow update: if isCreator() || (isInvitedByEmail() && onlyUpdatingJoinFields() && isAddingOwnUid());

        // Only creator can delete the group
        allow delete: if isCreator();

        // Fetch parent SE data — Firestore caches this per request,
        // so a list query with N docs costs 1 billed get(), not N.
        function parentSE() {
          return get(/databases/$(database)/documents/environments/$(dataId)/sharedExpenses/$(seId)).data;
        }

        // Check caller's UID is in the parent SE's participant list.
        // UID-based only: by the time a user reads sub-collections,
        // invite resolution has already run and their UID is registered.
        function isSeParticipant() {
          return isAuthenticated() && request.auth.uid in parentSE().participantUids;
        }

        // Sub-collection: Expenses
        match /expenses/{docId} {

          // Read: must be a registered participant of the parent SE
          allow read: if isSeParticipant();

          // Create: must be a participant AND either the group creator or recording own expense
          allow create: if isAuthenticated()
            && isSeParticipant()
            && (
              request.resource.data.creatorUid == request.auth.uid
              || request.resource.data.paidByEmail == request.auth.token.email
            );

          // Update/Delete: group creator has full control; others only if they are the payer
          allow update, delete: if isAuthenticated()
            && (
              resource.data.creatorUid == request.auth.uid
              || resource.data.paidByEmail == request.auth.token.email
            );
        }

        // Sub-collection: Payments
        match /payments/{docId} {

          // Read: must be a registered participant of the parent SE
          allow read: if isSeParticipant();

          // Create: must be a participant AND either the group creator or recording own payment
          allow create: if isAuthenticated()
            && isSeParticipant()
            && (
              request.resource.data.creatorUid == request.auth.uid
              || request.resource.data.fromEmail == request.auth.token.email
            );

          // Update/Delete: group creator has full control; others only if they are the sender
          allow update, delete: if isAuthenticated()
            && (
              resource.data.creatorUid == request.auth.uid
              || resource.data.fromEmail == request.auth.token.email
            );
        }

      }
    }
  }
}
